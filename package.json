{
  "name": "dnd-maintainer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "npx supabase start && npx supabase gen types typescript --local > src/types/supabase.ts && vite",
    "stop": "npx supabase stop --yes",
    "dev": "vite",
    "typecheck": "tsc -b --noEmit",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "coverage:matrix": "COVERAGE_WRITE=1 vitest run src/lib/sources/coverage-matrix.test.ts",
    "uat:checklist": "TSX_TSCONFIG_PATH=tsconfig.app.json tsx scripts/gen-uat-checklist.ts",
    "supabase:types": "npx supabase gen types typescript --local > src/types/supabase.ts",
    "supabase:reset": "npx supabase stop --no-backup && npx supabase start && npm run supabase:types",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:bdd": "TSX_TSCONFIG_PATH=tsconfig.app.json tsx --import ./features/support/register.mjs ./node_modules/@cucumber/cucumber/bin/cucumber.js --exit",
    "test:bdd:future": "TSX_TSCONFIG_PATH=tsconfig.app.json tsx --import ./features/support/register.mjs ./node_modules/@cucumber/cucumber/bin/cucumber.js --exit --profile future"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@supabase/supabase-js": "^2.107.0",
    "@tanstack/react-query": "^5.101.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.1",
    "loglevel": "^1.9.2",
    "lucide-react": "^1.17.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.17.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.0.0",
    "@cucumber/gherkin": "^39.1.0",
    "@cucumber/messages": "^32.3.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/devtools-vite": "^0.7.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18next": "^6.1.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "esmock": "^2.7.6",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "shadcn": "^4.10.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
